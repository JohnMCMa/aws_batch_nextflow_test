plugins {
    id 'nf-wave'
    id 'nf-amazon'}

wave {
    enabled = true}

fusion {
    enabled = true
}

process {
    executor = 'awsbatch'
    queue    = 'nextflow-queue'    
    cpus   = 1
    memory = '2 GB'
// Error strategy: retry on transient AWS Batch issues    errorStrategy = { task.exitStatus in [130, 137, 143, 151] ? 'retry' : 'finish' }
    maxRetries = 3
withName: FASTQC {
        container = 'biocontainers/fastqc:v0.11.9_cv8'    }

withName: MULTIQC {
        container = 'multiqc/multiqc:v1.14'    }
}

aws {
    region = 'us-east-1'
    batch {
        volumes = '/fusion'    }
}

workDir = 's3://nextflow-demo-johnma-1/work'